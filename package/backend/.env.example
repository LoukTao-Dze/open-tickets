PORT=3000
# Comma-separated list of allowed origins for CORS (deployed frontend URL, no trailing slash)
CORS_ORIGINS=https://open-tickets-frontend.vercel.app
# DISCORD_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=

# Google OAuth client ID used by the Google Drive integration.
GOOGLE_DRIVE_CLIENT_ID=

# OAuth client secret. Keep secret and rotate if it has been exposed.
GOOGLE_DRIVE_CLIENT_SECRET=

# OAuth refresh token used to obtain Google Drive access tokens. Keep secret.
GOOGLE_DRIVE_REFRESH_TOKEN=

# Google Drive folder ID used as the integration's root folder.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Google Cloud project ID used by the Google Drive integration.
GOOGLE_CLOUD_PROJECT_ID=

# Local
GOOGLE_DRIVE_REDIRECT_URI=
