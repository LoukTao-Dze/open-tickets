PORT=3000
# Comma-separated list of allowed origins for CORS (deployed frontend URL, no trailing slash)
CORS_ORIGINS=https://open-tickets-frontend.vercel.app
# DISCORD_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=

# Required for token login. For Docker Compose, REDIS_URL is overridden to redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Keep true for HTTPS; set false only for local HTTP development.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
